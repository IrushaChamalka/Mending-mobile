# Copy to .env and fill in. Only EXPO_PUBLIC_* values are bundled into the app.
# See README "Pointing the app at a local backend" for which host to use.

# Backend base URL, without a trailing slash.
# Android emulator: http://10.0.2.2:3000   iOS simulator: http://localhost:3000   Device: http://<your-LAN-IP>:3000
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# true = serve mock data from each feature's api/mock layer instead of calling the backend.
EXPO_PUBLIC_USE_MOCK_API=false

# Sentry DSN. Leave empty to disable error reporting.
EXPO_PUBLIC_SENTRY_DSN=

# true = also report to Sentry from development builds (off by default).
EXPO_PUBLIC_SENTRY_ENABLE_IN_DEV=false

# Environment label sent to Sentry: development | preview | production
EXPO_PUBLIC_APP_ENV=development

# Build-time only, used by the Sentry Expo plugin to upload source maps. Never prefix these with EXPO_PUBLIC_.
# Leave SENTRY_AUTH_TOKEN empty to build without uploading source maps.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
